# Portal Empresa — riel fiat (nombres, sin secretos)
# Copiá a .env.local. No commitees valores reales.
# Koywe PAYIN (marco legal AR): https://docs.koywe.com/en/accepting-payments
KOYWE_API_KEY=
KOYWE_SECRET=
KOYWE_ORG_ID=
KOYWE_MERCHANT_ID=
KOYWE_WEBHOOK_SECRET=
KOYWE_API_URL=https://api-sandbox.koywe.com/api/v1
# KOYWE_PAYIN_METHOD=   # opcional: fuerza TRANSFER / KHIPU

# Circle Mint (HQ Canadá/US). La SA argentina no es clienta.
CIRCLE_API_KEY=
CIRCLE_MINT_API_KEY=
CIRCLE_WIRE_BANK_ID=
CIRCLE_WEBHOOK_SECRET=
CIRCLE_API_URL=https://api-sandbox.circle.com/v1

# BlindPay (Stellar nativo). Dictamen PSAV pendiente. No vender a compliance minero.
BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_WEBHOOK_SECRET=

# Tesorería Lumina firma deposit() + assign_oracle. Opt-in explícito.
TREASURY_DEPOSIT_ENABLED=false
TREASURY_SECRET=
# SPONSOR_SECRET=       # fallback si no hay TREASURY_SECRET

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORACLE_ADDRESS=
NEXT_PUBLIC_MIRA_PAYOUT_ADDRESS=
# Pegá hashes live cuando existan (jury):
# NEXT_PUBLIC_USDT0_PROOF_TX=
# NEXT_PUBLIC_LAST_RELEASE_TX=
